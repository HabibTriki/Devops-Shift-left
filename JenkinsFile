pipeline {
  agent any
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    VENV_DIR = 'venv'
    PYTHONDONTWRITEBYTECODE = '1'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Set up Python environment') {
      steps {
        bat '''
          @echo on
          setlocal EnableDelayedExpansion

          rem Create venv
          python -m venv "%VENV_DIR%" || exit /b 1

          rem Upgrade pip
          call "%VENV_DIR%\\Scripts\\python" -m pip install --upgrade pip || exit /b 1

          rem Install project deps (if any)
          if exist requirements.txt (
            call "%VENV_DIR%\\Scripts\\python" -m pip install -r requirements.txt || exit /b 1
          )

          rem Install test tooling
          call "%VENV_DIR%\\Scripts\\python" -m pip install pytest pytest-cov pytest-junitxml || exit /b 1

          rem Show interpreter just to confirm
          call "%VENV_DIR%\\Scripts\\python" -c "import sys; print(sys.version)"
        '''
      }
    }


    stage('Run unit tests') {
      steps {
        bat '''
          @echo on
          setlocal EnableDelayedExpansion

          if not exist reports mkdir reports
          if not exist coverage mkdir coverage

          call "%VENV_DIR%\\Scripts\\python" -m pytest -q ^
            --junitxml=reports\\junit.xml ^
            --cov=. ^
            --cov-report=xml:coverage\\coverage.xml

          set EXITCODE=%ERRORLEVEL%
          echo Pytest exit code: %EXITCODE%
          exit /b %EXITCODE%
        '''
      }
    }

  }

  post {
    always {
      junit testResults: 'reports/junit.xml', allowEmptyResults: true
      archiveArtifacts artifacts: 'reports/**,coverage/**', allowEmptyArchive: true, onlyIfSuccessful: false
      bat 'rmdir /S /Q "%VENV_DIR%" || exit /b 0'
      cleanWs()
    }
  }

}