pipeline {
  agent any
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    VENV_DIR = 'venv'
    PYTHONDONTWRITEBYTECODE = '1'
    SNYK_TOKEN = credentials('snyk-api-token')
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Set up Python environment') {
      steps {
        bat '''
          python -m venv %VENV_DIR% || exit /b 1
          call %VENV_DIR%\\Scripts\\python -m pip install --upgrade pip || exit /b 1
          if exist requirements.txt (
            call %VENV_DIR%\\Scripts\\python -m pip install -r requirements.txt || exit /b 1
          )
          call %VENV_DIR%\\Scripts\\python -m pip install pytest pytest-cov bandit || exit /b 1
        '''
      }
    }

    stage('SAST - Bandit Security Scan') {
      steps {
        bat '''
          @echo on
          if not exist security-reports mkdir security-reports

          echo ========================================
          echo Running Bandit Security Scan...
          echo ========================================

          rem Generate reports (warning-only mode)
          call venv\\Scripts\\bandit -r . -x ./venv,./tests,./.git -f json -o security-reports\\bandit-report.json  || set BANDIT_FAILED=1
          call venv\\Scripts\\bandit -r . -x ./venv,./tests,./.git -f txt  -o security-reports\\bandit-report.txt   || set BANDIT_FAILED=1
          call venv\\Scripts\\bandit -r . -x ./venv,./tests,./.git -f html -o security-reports\\bandit-report.html  || set BANDIT_FAILED=1

          echo.
          echo ========================================
          echo Bandit Scan Results (Summary):
          echo ========================================
          call venv\\Scripts\\bandit -r . -x ./venv,./tests,./.git -ll -f screen  || set BANDIT_FAILED=1

          if defined BANDIT_FAILED (
            echo.
            echo [WARNING] Bandit found issues. Reports saved under security-reports\\bandit-report.*
            rem STRICT MODE (later): to fail build on findings, replace the next line with:  exit /b 1
          )

          rem IMPORTANT: keep pipeline going regardless of Bandit result
          exit /b 0
        '''
      }
    }

    stage('SCA - Snyk Dependency Scan') {
      steps {
        bat '''
          @echo on
          if not exist security-reports mkdir security-reports

          rem Check if Snyk is available
          where snyk >nul 2>&1
          if errorlevel 1 (
            echo [ERROR] Snyk not found in PATH
            echo [ERROR] Try installing: npm install -g snyk
            echo SNYK SCAN SKIPPED - Snyk not installed > security-reports\\snyk-status.txt
            echo Please install Snyk: npm install -g snyk >> security-reports\\snyk-status.txt
            exit /b 0
          )

          echo ========================================
          echo Running Snyk Dependency Scan...
          echo ========================================

          echo Authenticating with Snyk...
          snyk auth %SNYK_TOKEN%
          if errorlevel 1 (
            echo [ERROR] Snyk authentication failed
            echo SNYK SCAN FAILED - Authentication error > security-reports\\snyk-status.txt
            exit /b 0
          )

          echo.
          echo Running Snyk vulnerability test...
          snyk test --file=requirements.txt --package-manager=pip --severity-threshold=high --json-file-output=security-reports\\snyk-report.json || set SNYK_FAILED=1
          snyk test --file=requirements.txt --package-manager=pip --severity-threshold=high > security-reports\\snyk-report.txt 2>&1 || set SNYK_FAILED=1

          echo.
          echo ========================================
          echo Snyk Scan Results (Summary):
          echo ========================================
          snyk test --file=requirements.txt --package-manager=pip --severity-threshold=high || echo Vulnerabilities found

          if defined SNYK_FAILED (
            echo.
            echo [WARNING] Snyk found HIGH/CRITICAL vulnerabilities!
            echo SNYK SCAN FAILED - Vulnerabilities detected > security-reports\\snyk-status.txt
            echo Check the following reports: >> security-reports\\snyk-status.txt
            echo   - security-reports\\snyk-report.txt >> security-reports\\snyk-status.txt
            echo   - security-reports\\snyk-report.json >> security-reports\\snyk-status.txt
            echo Will be fixed later >> security-reports\\snyk-status.txt
          ) else (
            echo.
            echo [SUCCESS] No HIGH/CRITICAL vulnerabilities found
            echo SNYK SCAN PASSED > security-reports\\snyk-status.txt
          )

          rem IMPORTANT: keep pipeline going regardless of Snyk result (like Bandit)
          exit /b 0
        '''
      }
    }


    stage('Run unit tests') {
      steps {
        bat '''
          @echo on
          setlocal EnableDelayedExpansion

          if not exist reports mkdir reports
          if not exist coverage mkdir coverage

          echo ========================================
          echo Running Unit Tests...
          echo ========================================

          call "%VENV_DIR%\\Scripts\\python" -m pytest -v ^
            --junitxml=reports\\junit.xml ^
            --cov=. ^
            --cov-report=xml:coverage\\coverage.xml ^
            --cov-report=html:coverage\\htmlcov

          set EXITCODE=%ERRORLEVEL%
          echo Pytest exit code: %EXITCODE%
          exit /b %EXITCODE%
        '''
      }
    }

  }

  post {
    always {
      // Publish test results
      junit testResults: 'reports/junit.xml', allowEmptyResults: true
      
      // Archive all reports
      archiveArtifacts artifacts: 'reports/**,coverage/**,security-reports/**', allowEmptyArchive: true, onlyIfSuccessful: false
      
      // HTML reports are archived as artifacts above
      // You can view them by downloading from the artifacts section
      
      // Clean up
      bat 'rmdir /S /Q "%VENV_DIR%" || exit /b 0'
      cleanWs()
    }
    
    success {
      echo '========================================='
      echo 'Pipeline PASSED!'
      echo 'All security scans and tests succeeded.'
      echo '========================================='
    }
    
    failure {
      echo '========================================='
      echo 'Pipeline FAILED!'
      echo 'Check security reports or test results.'
      echo '========================================='
    }
  }

}